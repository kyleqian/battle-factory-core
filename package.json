{
  "name": "pokeemerald-factory-run",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "NODE_OPTIONS=--max-old-space-size=8192 tsc -b && vite build",
    "typecheck": "NODE_OPTIONS=--max-old-space-size=8192 tsc -b",
    "preview": "vite preview",
    "test": "NODE_OPTIONS=--max-old-space-size=8192 vitest run --no-watch --pool=forks --testTimeout=20000",
    "test:smoke": "vitest run --no-watch --pool=forks --testTimeout=20000 tests/executableFrontierRatchet.test.ts tests/abilityItemParityCensus.test.ts tests/battleDecisionBoundary.test.ts tests/factoryBattleScriptFullTurnDecision.test.ts tests/roundController.test.ts tests/roundScenarioMatrix.test.ts tests/battleScene.test.ts tests/battleScriptRulesContext.test.ts",
    "soak": "node --experimental-strip-types tools/soak/randomRoundSoak.ts",
    "sweep-scratch": "node --experimental-strip-types tools/sweep-scratch-dirs.ts",
    "compare": "node --experimental-strip-types tools/compare/run.ts",
    "compare:batch": "node --experimental-strip-types tools/compare/batch.ts",
    "compare:differential": "node --experimental-strip-types tools/compare/app-differential.ts",
    "inspect-frame": "node --experimental-strip-types tools/compare/inspect-frame.ts",
    "animation:coverage": "node --experimental-strip-types tools/animation/report.ts",
    "census:ability-item": "node --experimental-strip-types tools/report/ability-item-parity-census.ts",
    "extract:ability-item-hooks": "node --experimental-strip-types tools/extract/extract-ability-item-hooks.ts",
    "animation:components": "node --experimental-strip-types tools/extract/extract-battle-animation-components.ts",
    "extract:level50-move-parameterization": "node --experimental-strip-types tools/extract/extract-level50-move-parameterization.ts",
    "extract:frontier-trainers": "node --experimental-strip-types tools/extract/extract-battle-frontier-trainers.ts",
    "extract:facility-class-lookups": "node --experimental-strip-types tools/extract/extract-facility-class-lookups.ts",
    "extract:frontier-trainer-pics": "node --experimental-strip-types tools/extract/extract-frontier-trainer-pics.ts",
    "extract:party-mon-icons": "node --experimental-strip-types tools/extract/extract-party-mon-icons.ts",
    "extract:party-menu-source": "node --experimental-strip-types tools/extract/extract-party-menu-source.ts",
    "compare:fire-punch-portable": "node --experimental-strip-types tools/compare/firePunchPortable.ts",
    "compare:ice-punch-portable": "node --experimental-strip-types tools/compare/firePunchPortable.ts tools/compare/fixtures/ice-punch-onix-grovyle.json",
    "compare:ice-punch-opposite": "node --experimental-strip-types tools/compare/firePunchPortable.ts tools/compare/fixtures/ice-punch-grovyle-onix.json",
    "compare:faint-attack-portable": "node --experimental-strip-types tools/compare/faintAttackPortable.ts",
    "compare:double-team-portable": "node --experimental-strip-types tools/compare/doubleTeamPortable.ts",
    "compare:factory-swap-duplicate-species": "node --experimental-strip-types tools/compare/factorySwapDuplicateSpecies.ts",
    "compare:endeavor-portable": "node --experimental-strip-types tools/compare/endeavorPortable.ts",
    "compare:feather-dance-portable": "node --experimental-strip-types tools/compare/featherDancePortable.ts",
    "compare:feather-dance-opposite": "node --experimental-strip-types tools/compare/featherDancePortable.ts tools/compare/fixtures/feather-dance-player-pidgeotto-onix.json",
    "compare:quick-attack-portable": "node --experimental-strip-types tools/compare/quickAttackPortable.ts",
    "compare:quick-attack-opposite": "node --experimental-strip-types tools/compare/quickAttackPortable.ts tools/compare/fixtures/quick-attack-player-pidgeotto-onix.json",
    "compare:quick-attack-opposite-controller": "node --experimental-strip-types tools/compare/quickAttackPortable.ts tools/compare/fixtures/quick-attack-player-pidgeotto-onix-controller.json",
    "compare:aerial-ace-portable": "node --experimental-strip-types tools/compare/aerialAcePortable.ts",
    "compare:aerial-ace-opposite": "node --experimental-strip-types tools/compare/aerialAcePortable.ts tools/compare/fixtures/aerial-ace-player-pidgeotto-onix.json",
    "compare:fly-portable": "node --experimental-strip-types tools/compare/flyPortable.ts",
    "compare:bounce-portable": "node --experimental-strip-types tools/compare/bouncePortable.ts"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "pngjs": "^7.0.0",
    "typescript": "~5.6.2",
    "vite": "^6.0.1",
    "vitest": "^2.1.8"
  }
}
