[Unit]
Description=Pokebench autonomous %i supervisor
After=network-online.target
Wants=network-online.target

[Service]
Type=exec
User=pokebench
Group=pokebench
WorkingDirectory=/srv/pokebench/pokeemerald-factory-core
EnvironmentFile=/etc/pokebench-autonomy.env
Environment=HOME=/home/pokebench
Environment=PATH=/home/pokebench/.local/bin:/home/pokebench/.cargo/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=/srv/pokebench/pokeemerald-factory-core/workspace/tools/autonomy/run-lane.sh %i
KillMode=control-group
TimeoutStartSec=6h
TimeoutStopSec=20min
RuntimeDirectory=pokebench-autonomy
RuntimeDirectoryMode=0750
StateDirectory=pokebench-autonomy
StateDirectoryMode=0750
UMask=0027
Nice=5
IOSchedulingClass=best-effort
IOSchedulingPriority=6
StandardOutput=journal
StandardError=journal
SyslogIdentifier=pokebench-%i

[Install]
WantedBy=multi-user.target
