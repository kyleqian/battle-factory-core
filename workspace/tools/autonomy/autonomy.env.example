# Installed as /etc/pokebench-autonomy.env by install-systemd.sh.
# AUTONOMY_END_EPOCH is required and is an absolute UTC epoch timestamp.
AUTONOMY_END_EPOCH=0
AUTONOMY_RUN_ID=replace-me
POKEBENCH_REPO_ROOT=/srv/pokebench/pokeemerald-factory-core
POKEBENCH_GIT_REMOTE=origin
POKEBENCH_BACKUP_NAMESPACE=autonomy/replace-me
POKEBENCH_MIN_FREE_GB=30
POKEBENCH_ANIMATION_CAP_HOURS=5.5
POKEBENCH_RUST_CAP_HOURS=4
# Each lane can independently use codex/codex, claude/claude, or a hybrid.
# Claude defaults resolve to Fable 5 supervisors and Sonnet 5 workers.
POKEBENCH_ANIMATION_SUPERVISOR_AGENT=codex
POKEBENCH_ANIMATION_SUB_AGENT=codex
POKEBENCH_RUST_SUPERVISOR_AGENT=codex
POKEBENCH_RUST_SUB_AGENT=codex
# Keep the reproducible native Claude Code pin instead of background updates.
DISABLE_AUTOUPDATER=1
# A single full TypeScript gate can consume roughly 14 GiB resident on Linux.
# Keep it to two forks; the swap guard absorbs a concurrent Rust build, while
# two simultaneous full TypeScript gates would require the 32 GiB tier.
POKEBENCH_VITEST_MAX_WORKERS=2
CARGO_BUILD_JOBS=4
