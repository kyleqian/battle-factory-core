 "gate": "src/engine/liveMoveAnimation.ts case 244/315/318: 315 requires spriteOrderInput.firstBody; 244/318 require spriteOrderInput.known (Psych Up and Silver Wind: spriteOrderWithOccupiedPrefix(free, KNOWN_ENTRY_OCCUPIED_SPRITE_ORDER) non-null).",
 "registerConsumption": {
  "finding": "The activation BG registers (the bg-register history) never reach the pixels of any of the three bodies: every register field the compositor reads is rewritten by the reducer before it is read.",
  "silverWind": "compositor src/engine/battleScene.ts SILVER_WIND branch reads view.registers.bldcnt/bldy (rewritten every age, src/animation/silverWind.ts backgroundAtAge fade block), bg3hofs (only while the BUG BG is visible, age >= 32; rewritten from age 31) and bg{monbg.bg}cnt & 3 only while displayed.background.monbgActive (ages 7..clearEnd+1, where the reducer sets bg1cnt := monbg.splitBg1Cnt, bg2cnt := monbg.splitBg2Cnt). Opponent: monbg.bg = 2 -> reads splitBg2Cnt 0x5e02 (constant); its history-dependent splitBg1Cnt is never read. Player: splitBg1Cnt 0x5c01 is the rule's fixed `set` row (318/player).",
  "psychUp": "compositor PSYCH_UP branch reads view.registers.bldalpha only for the spiral (displayed age >= 7 -> current age >= 8) and the attacker affine blend (age >= 142); psychUpAtAge returns input.registers only for age < 7. background.bgCnt / hardwareScroll (initialBgCnt / initialHardwareScroll) are never read by the compositor.",
  "overheat": "compositor OVERHEAT branch reads view.registers.bldalpha only; registersAtAge (src/animation/overheat.ts) rewrites bldcnt/bldalpha every age.",
  "test": "tests/animation/liveLaterBodiesBg.test.ts renders renderSceneOnMovePresentation (live field) at every age with S0, the rule's later-body inputs and an absurd override: identical frames (318 both sides, 244 player, 315 player)."
 },
 "experiments": {
  "a_firstBodyInputsGateWidened": "all 11 later-body fixtures 0 px twice fresh (this receipt's freshRuns; the production inputs on later bodies ARE the first-body inputs)",
  "b_ruleInputs": "not separately rendered against the ROM: by the compositor read set (registerConsumption) and the render-invariance test, (b) renders the same frames as (a) at every age",
  "orderLendControl": "POKEBENCH_LIVE_ORDER_HIT=damaging (verifier fallback also feeds the visible hit after Psychic / Silver Wind, as production does): identical digests, 0 px, every fixture"
 },
