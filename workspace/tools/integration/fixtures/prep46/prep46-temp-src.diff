diff --git a/workspace/src/engine/liveWordsOrderCarry.ts b/workspace/src/engine/liveWordsOrderCarry.ts
new file mode 100644
index 000000000..fa6d1da85
--- /dev/null
+++ b/workspace/src/engine/liveWordsOrderCarry.ts
@@ -0,0 +1,78 @@
+/**
+ * TEMPORARY (prep46 patch; docs/next-adapters-prep46.md s3): post-body free order of a WORDS-DEPENDENT order unit (Sand-Attack 28, Mud-Slap 189,
+ * Rain Dance 240), carried through the body with the body's own recorded presentation words (render-pure; the order tracker stays word-free).
+ * Same rules as tools/integration/prep46Carry.ts (ROM-checked per frame with RAM-read words).
+ */
+import { mudSlapMudAtAge, MUD_SLAP_MUD_FIRST_DISPLAY_AGE, MUD_SLAP_MUD_HALF_SIZE } from "../animation/mudSlap.ts";
+import { rainDanceAtAge } from "../animation/rainDance.ts";
+import { sandAttackDirtAtAge, SAND_ATTACK_DIRT_FIRST_DISPLAY_AGE } from "../animation/sandAttack.ts";
+import { sortGbaSpriteOrder } from "../animation/gbaObjCompositor.ts";
+import { carryLiveSpriteOrder } from "./liveMoveOamAssembler.ts";
+import { dirtScatterOffsetFromWord, dirtScatterSlots, linearTranslationStep } from "./liveMovePresentationRng.ts";
+import type { PresentationRngWords } from "./presentationRngHost.ts";
+import { KNOWN_ENTRY_OCCUPIED_SPRITE_ORDER, spriteOrderWithOccupiedPrefix } from "./spriteOrderProvider.ts";
+
+type Point = Readonly<{ x: number; y: number }>;
+export const WORDS_ORDER_UNIT_MOVE_IDS: readonly number[] = Object.freeze([28, 189, 240]);
+const ENTRY_IN_USE: readonly number[] = Object.freeze([0, 1, 2, 6, 8, 60, 61, 62, 63]);
+const UNCONSUMED = Object.freeze(new Array<number>(512).fill(0));
+
+function dirtSortPass(order: number[], current: readonly { slot: number; y: number }[], half: number): void {
+  const packed = new Array<number>(64).fill((3 << 8) | 255);
+  const y = new Array<number>(64).fill(-96);
+  for (const sprite of current) { packed[sprite.slot] = (2 << 8) | 2; y[sprite.slot] = sprite.y - half; }
+  for (let index = 1; index < order.length; index += 1) {
+    let cursor = index;
+    while (cursor > 0) {
+      const prior = order[cursor - 1]!, next = order[cursor]!;
+      if (packed[prior]! > packed[next]! || (packed[prior] === packed[next] && y[prior]! < y[next]!)) {
+        order[cursor - 1] = next; order[cursor] = prior; cursor -= 1;
+      } else break;
+    }
+  }
+}
+
+/** Free order after a words body from its activation free order (null = not a words unit / words or order unavailable). */
+export function liveWordsBodyPostFree(
+  moveId: number, attackerSide: "player" | "opponent", activationFree: readonly number[], words: PresentationRngWords | null,
+  attackerPic: Point, targetPic: Point,
+): readonly number[] | null {
+  const start = spriteOrderWithOccupiedPrefix({ known: true as const, free: activationFree, pendingDestroyed: [] }, KNOWN_ENTRY_OCCUPIED_SPRITE_ORDER);
+  if (start === null || words === null) return null;
+  let order = start.slice();
+  if (moveId === 240) {
+    const profile = { animationRngAtAge0: words.activationValue, occupiedSpriteSlots: ENTRY_IN_USE, unfadedPaletteBeforeLoad: UNCONSUMED,
+      fadedPaletteBeforeLoad: UNCONSUMED, hardwarePaletteAtAge0: UNCONSUMED, unfadedPaletteAfterLoad: UNCONSUMED, fadedPaletteAfterLoad: UNCONSUMED };
+    for (let age = 0; age < 187; age += 1) {
+      // task-created drops join SortSprites one frame after birth (BattleMainCB2: BuildOamBuffer before RunTasks)
+      const keys = rainDanceAtAge(age, profile).drops.filter((d) => d.sourcePass >= 1)
+        .map((d) => ({ slot: d.slot, attr: d.attr, subpriority: d.subpriority, visible: true, oamY: d.attr[0] & 0xff }));
+      order = carryLiveSpriteOrder(order, keys as never, sortGbaSpriteOrder);
+    }
+  } else if (moveId === 28 || moveId === 189) {
+    const mud = moveId === 189, draws = words.draws;
+    if (draws.length !== 6 || draws.some((row) => row.length !== 10)) return null;
+    const flat = draws.flat(), playerAttacker = attackerSide === "player";
+    const source = { x: attackerPic.x + (playerAttacker ? 15 : -15), y: attackerPic.y + 15 };
+    const transients: [number, number][] = mud ? [[4, 8], [9, 11]] : [[7, 11], [12, 14]];
+    const slots = dirtScatterSlots(transients, mud ? 9 : 12, ENTRY_IN_USE);
+    const seeds = slots.map((slot, i) => ({ slot,
+      xStep: linearTranslationStep(targetPic.x + dirtScatterOffsetFromWord(flat[2 * i]!) - source.x, 20),
+      yStep: linearTranslationStep(targetPic.y + dirtScatterOffsetFromWord(flat[2 * i + 1]!) - source.y, 20) }));
+    const profile = mud ? { mud: seeds, spriteOrderSeed: start } : { dirt: seeds, spriteOrderSeed: start };
+    const ageOffset = mud ? 42 : 43, first = mud ? MUD_SLAP_MUD_FIRST_DISPLAY_AGE : SAND_ATTACK_DIRT_FIRST_DISPLAY_AGE;
+    const transientSub = (playerAttacker ? 30 : 40) - 2;
+    for (let age = 0; age < (mud ? 51 : 58); age += 1) {
+      const r = age + ageOffset + 1;
+      if (r < first) {
+        const live = transients.filter(([from, to]) => age >= from && age < to);
+        order = carryLiveSpriteOrder(order, live.map(() => ({ slot: 3, attr: [0x00a0, 0, 3 << 10] as never, subpriority: transientSub, visible: false, oamY: 160 })), sortGbaSpriteOrder);
+      } else {
+        const current = (mud ? mudSlapMudAtAge(r, attackerPic, attackerSide, profile as never) : sandAttackDirtAtAge(r, attackerPic, attackerSide, profile as never))
+          .map(({ slot, y }) => ({ slot, y }));
+        dirtSortPass(order, current, mud ? MUD_SLAP_MUD_HALF_SIZE : 4);
+      }
+    }
+  } else return null;
+  return Object.freeze(order.filter((slot) => !KNOWN_ENTRY_OCCUPIED_SPRITE_ORDER.includes(slot)));
+}
