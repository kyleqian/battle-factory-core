 "schema": "playerfaint-lend-receipt/v1",
 "scope": "S10A presentation-only: sprite-order lend + allocator re-seed after a player faint + forced party menu + reshowPlayerGone + forced switch-in (docs/playerfaint-lend-audit.md \u00a74). Gameplay, RNG, damage, turn order and facility state untouched (ON/OFF parity on routes). The voluntary switch (reshowBoth / recall) still declines. Not whole-playable arbitrary-history exactness.",
 "productionCodeCommit": "28bea5f9c",
 "srcTree": "3172ec9ff8827a221d5f8c63161e269df7bc9f7c",
 "api": {
  "SpriteOrderTracker.occupantRoles": "{ healthboxMain: {player, opponent}, shadow } | null: entry 0/1/2 (KNOWN_ENTRY_OCCUPANT_ROLES); null after party-menu-reset, reshowBoth and the provisional recall; reshowPlayerGone sets them from its survivors n1 / n4 / n7 (ROM 1 / 2 / 3); faint, summary, send-out, switch-in and bodies keep them",
  "createSpriteOrderTracker(order, battlerSlots?, occupantRoles?)": "roles default to the entry roles, kept only while all occupied",
  "spriteOrderTrackerPostUnitView(tracker)": "adds occupantRoles",
  "spriteOrderEntryLabelRelabel(view)": "rho: battlers -> 6/8, healthbox mains -> 0/1, shadow -> 2, 60..63 fixed, free slots rank-for-rank onto the known-entry free set; null unless occupied == exactly that 9-slot role set; view.occupantRoles undefined = entry roles (= pi), null = decline",
  "liveSpriteAllocatorReseedable(host)": "lastUnit send-out, or switch-in with roles known (forced chain), and role-isomorphic",
  "reseedLiveSpriteAllocatorAfterSendOut(allocator, host, route?)": "re-seeds the known-entry firstMove host whenever liveSpriteAllocatorReseedable",
  "orchestrator": "presenting-switch-in (forced replacement) re-seeds the allocator once after the forced switch-in and keeps it for the rest of the switch-in presentation (the forced switch-in command is never presented in the ordinary phase, so the ~:2262 call site does not see it)",
  "postkoHostReplay.replayPostKoTurnsThroughHost": "replays the forced-party-menu marker (open + return party menu hooks, allocator invalidated, re-seeded after the switch-in)"
 },
 "pureHost": {
  "modelCheckEdges": "41 known edges (7 entry + 27 after a forced switch-in + 7 after opponent KOs) lent == model-check roleLend; rho == reference roleMap at every edge; 14 edges production lent before == unchanged; 4 strict-unknown (202:player) decline (tests/playerfaintLend.test.ts)",
  "hostReplay": "13/13 fixtures: precedingTurns == playerfaintTurnsToEdge; production host lend == roleLend == whatif-*-role.json lendFree; Light Screen / Protect allocator input from the re-seeded host"
 },
