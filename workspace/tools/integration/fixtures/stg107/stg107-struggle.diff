+    const attackerAttr = withX2(attackerObject.attr, p.attackerX2(state));
+    out.push({ slot: attackerObject.slot, attr: attackerAttr, subpriority: attackerObject.subpriority, visible: true, oamY: attackerAttr[0] & 0xff });
