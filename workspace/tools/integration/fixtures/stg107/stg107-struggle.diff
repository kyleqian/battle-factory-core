+      const attr: OamAttr = [0x0100 | 0x0400 | y - 16 & 0xff, 0x8000 | x - 16 & 0x1ff, STRUGGLE_IMPACT_TILES[0] | 2 << 10 | STRUGGLE_IMPACT_SLOT << 12];
