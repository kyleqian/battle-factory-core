 ],
 "sourceUnderTest": {
  "encoreArm": "reference/pokeemerald/src/battle_util.c:111-117 HandleAction_UseMove: encoredMove != MOVE_NONE && encoredMove == moves[encoredMovePos] -> gCurrentMove = encoredMove, gCurrMovePos = encoredMovePos, moveTarget = GetMoveTarget(gCurrentMove, NO_TARGET_OVERRIDE). Evaluated at the battler's OWN action, so an Encore set earlier in the same turn applies",
  "encoreOverwrittenArm": "reference/pokeemerald/src/battle_util.c:119-128 (encored slot overwritten -> clear Encore, use the slot) -- not reachable here",
  "setEncore": "reference/pokeemerald/src/battle_script_commands.c:8017 Cmd_trysetencore: encoredMove = moves[i] where moves[i] == gLastMoves[target]; encoreTimer = (Random() & 3) + 3 at :8039",
  "selectionBank": "reference/pokeemerald/src/battle_main.c:4194 (encored at selection -> gChosenMoveByBattler = encoredMove) / :4399 (slot move) -- on turn 2 SNORLAX is not encored at selection, so it banks DEFENSE CURL",
  "getMoveTarget": "reference/pokeemerald/src/battle_util.c:3828 GetMoveTarget; MOVE_TARGET_SELECTED do { Random() % gBattlersCount } while (target == attacker ...) :3850-3853"
 },
